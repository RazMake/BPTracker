<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BPTracker.Mobile.EntryPage"
             Title=""
             SizeChanged="OnPageSizeChanged">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Chart" Clicked="OnOpenChart" />
        <ToolbarItem Text="Settings" Clicked="OnOpenSettings" />
    </ContentPage.ToolbarItems>

    <!-- One FlexLayout so the orientation change is a single Direction switch. Reassigning
         Grid.Row at runtime left the old layout painted behind the new one on Android. -->
    <FlexLayout x:Name="RootLayout"
                Direction="Column"
                AlignItems="Stretch"
                BackgroundColor="{StaticResource Background}"
                Padding="12">

        <Border x:Name="SystolicCard" StrokeShape="RoundRectangle 18" Margin="4"
                FlexLayout.Grow="1" FlexLayout.Basis="0">
            <Grid RowDefinitions="Auto, *, Auto" Padding="12,10">
                <Label Grid.Row="0" Text="SYSTOLIC" Style="{StaticResource CaptionLabel}"
                       FontSize="20" HorizontalOptions="Center" />
                <Label Grid.Row="1" x:Name="SystolicValue"
                       Text="{Binding Systolic}"
                       FontSize="76"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Label Grid.Row="2" Text="SLIDE TO CHANGE, TAP TO TYPE"
                       Style="{StaticResource CaptionLabel}"
                       HorizontalOptions="Center" />
            </Grid>
            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnSystolicPan" />
                <TapGestureRecognizer Tapped="OnSystolicTapped" />
            </Border.GestureRecognizers>
        </Border>

        <Border x:Name="DiastolicCard" StrokeShape="RoundRectangle 18" Margin="4"
                FlexLayout.Grow="1" FlexLayout.Basis="0">
            <Grid RowDefinitions="Auto, *, Auto" Padding="12,10">
                <Label Grid.Row="0" Text="DIASTOLIC" Style="{StaticResource CaptionLabel}"
                       FontSize="20" HorizontalOptions="Center" />
                <Label Grid.Row="1" x:Name="DiastolicValue"
                       Text="{Binding Diastolic}"
                       FontSize="76"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Label Grid.Row="2" Text="SLIDE TO CHANGE, TAP TO TYPE"
                       Style="{StaticResource CaptionLabel}"
                       HorizontalOptions="Center" />
            </Grid>
            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnDiastolicPan" />
                <TapGestureRecognizer Tapped="OnDiastolicTapped" />
            </Border.GestureRecognizers>
        </Border>

        <Grid x:Name="ActionPanel" RowDefinitions="*, Auto" Margin="4"
              FlexLayout.Grow="1" FlexLayout.Basis="0">

            <VerticalStackLayout Grid.Row="0" Spacing="4" VerticalOptions="End" Margin="0,0,0,10">
                <Label x:Name="CategoryLabel"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <Label Text="{Binding Validation.Message}"
                       TextColor="{StaticResource Bad}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <!-- Deliberately quiet: almost no reading needs one, and nothing here may slow
                     down the two numbers that do matter. -->
                <Entry Placeholder="Tag (optional)"
                       Text="{Binding Tag}"
                       MaxLength="100"
                       FontSize="13"
                       ReturnType="Done"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Grid Grid.Row="1" ColumnDefinitions="Auto, *" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Text="Reset"
                        FontSize="18"
                        HeightRequest="64"
                        WidthRequest="110"
                        Command="{Binding ResetCommand}" />

                <Button Grid.Column="1"
                        Text="Save"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="20"
                        HeightRequest="64"
                        Command="{Binding SaveCommand}" />
            </Grid>
        </Grid>
    </FlexLayout>
</ContentPage>

