<?xml version="1.0" encoding="UTF-8" ?>
<!--
    One dark palette. The app is dark only, so there is no light variant to keep in step and no
    AppThemeBinding anywhere. See also Platforms\Android\Resources\values\colors.xml, which has to
    repeat the window and status bar colours for the native splash theme.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Background">#0F1419</Color>
    <Color x:Key="Surface">#181F27</Color>
    <Color x:Key="SurfacePressed">#212B35</Color>
    <Color x:Key="Stroke">#2C3742</Color>

    <Color x:Key="TextPrimary">#E9EEF3</Color>
    <Color x:Key="TextMuted">#8A98A6</Color>
    <Color x:Key="TextDisabled">#5A6773</Color>

    <Color x:Key="Accent">#4C8DFF</Color>
    <Color x:Key="AccentPressed">#3B72D6</Color>

    <!-- Kept in step with the chart, which paints the same three states. -->
    <Color x:Key="Good">#3FBF77</Color>
    <Color x:Key="Warn">#E8912D</Color>
    <Color x:Key="Bad">#E5484D</Color>

    <!-- Chart. Both lines are solid and neutral; the shading behind them carries the judgement,
         which is why the off-target wash is barely-there rather than loud. -->
    <Color x:Key="SeriesSystolic">#7EC8FF</Color>
    <Color x:Key="SeriesDiastolic">#B79CFF</Color>
    <Color x:Key="SeriesCrisis">#FF2D3E</Color>
    <Color x:Key="Tagged">#FFD166</Color>
    <Color x:Key="BandOffTarget">#1FE5484D</Color>
    <Color x:Key="BandOnTarget">#143FBF77</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource Stroke}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
</ResourceDictionary>
