<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BPTracker.Mobile.SettingsPage"
             Title="Storage">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="DATA FOLDER" Style="{StaticResource CaptionLabel}" />
            <Label Text="{Binding DataFolder}" FontSize="15" LineBreakMode="CharacterWrap" />

            <Label Text="THIS DEVICE WRITES" Style="{StaticResource CaptionLabel}" Margin="0,12,0,0" />
            <Label Text="{Binding DeviceJournalPath}" FontSize="15" LineBreakMode="CharacterWrap" />

            <Label FontSize="14" TextColor="{StaticResource TextMuted}" Margin="0,12,0,0"
                   Text="Point your sync app at the data folder. Each device only ever writes its own file, so there is nothing to merge and nothing to conflict." />

            <Button Text="Change folder..." Clicked="OnChangeFolder" Margin="0,12,0,0" />
            <Button Text="Copy path" Clicked="OnCopyPath" />
            <Button x:Name="GrantAccessButton"
                    Text="Allow access to all files"
                    Clicked="OnGrantAccess"
                    IsVisible="False" />

            <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Bad}" FontSize="14" />

            <Label Text="EXPORT" Style="{StaticResource CaptionLabel}" Margin="0,20,0,0" />
            <Label FontSize="14" TextColor="{StaticResource TextMuted}"
                   Text="Written into the data folder above, so your sync app picks them up too." />
            <Button Text="CSV" Clicked="OnExportCsv" />
            <Button Text="Chart - PNG" Clicked="OnExportChart" />
            <Button Text="Data - PNG" Clicked="OnExportData" />
            <Label x:Name="ExportStatusLabel" FontSize="14" TextColor="{StaticResource TextMuted}" />

            <Label Text="DEVICE ID" Style="{StaticResource CaptionLabel}" Margin="0,20,0,0" />
            <Label Text="{Binding DeviceId}" FontSize="15" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
