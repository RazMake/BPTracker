<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Android only. The desktop client is the WPF head; iOS and Mac are not targets. -->
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>BPTracker.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>BPTracker</ApplicationTitle>
    <ApplicationId>com.razmake.bptracker</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>

    <!-- UI heads are deliberately logic-free, so they are neither documented nor coverage-gated. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BPTracker.Application\BPTracker.Application.csproj" />
    <ProjectReference Include="..\BPTracker.Domain\BPTracker.Domain.csproj" />
    <ProjectReference Include="..\BPTracker.Infrastructure\BPTracker.Infrastructure.csproj" />
    <ProjectReference Include="..\BPTracker.Presentation\BPTracker.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F1419" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F1419" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
